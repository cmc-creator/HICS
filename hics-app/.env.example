# ---------------------------------------------------------------------------
# Server-side (Vercel project environment variables). Never prefix with VITE_.
# ---------------------------------------------------------------------------

# Required: signs access tokens. Use a long random value, e.g. `openssl rand -base64 48`.
TOKEN_SIGNING_SECRET=

# Required on Vercel: durable API store and shared rate limiting.
# Without these the API refuses to run on Vercel instead of silently losing data.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
HICS_STORE_REDIS_KEY=nyx:hics:store:v1

# Local development only: JSON file used when Redis isn't configured.
HICS_STORE_FILE_PATH=.nyx-hics-store.json

# Comma-separated emails that get enterprise-admin access before any users exist.
# Use this to sign in the first time, add real users from the Admin page, then clear it.
BOOTSTRAP_ADMIN_EMAILS=

# Defaults for new records and token claims
DEFAULT_ORGANIZATION_NAME=Enterprise Health System
DEFAULT_USER_FACILITY=general-acute-care

# Password sign-in for accounts created with `npm run create-user -- ... --password`.
# Keep false when everyone signs in through Entra ID or Okta.
ALLOW_LOCAL_AUTH_FALLBACK=false

# Refresh-session lifetime in days (the httpOnly refresh cookie)
REFRESH_TOKEN_TTL_DAYS=30

# Microsoft Entra ID (server-side token exchange and id_token verification)
OIDC_ENTRA_TOKEN_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
OIDC_ENTRA_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
OIDC_ENTRA_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_ENTRA_CLIENT_ID=
OIDC_ENTRA_CLIENT_SECRET=

# Okta (server-side token exchange and id_token verification)
OIDC_OKTA_TOKEN_URL=https://<your-okta-domain>/oauth2/default/v1/token
OIDC_OKTA_JWKS_URL=https://<your-okta-domain>/oauth2/default/v1/keys
OIDC_OKTA_ISSUER=https://<your-okta-domain>/oauth2/default
OIDC_OKTA_CLIENT_ID=
OIDC_OKTA_CLIENT_SECRET=

# Recommended: the exact callback URL registered with your identity provider
ALLOWED_OIDC_REDIRECT_URI=https://<your-domain>/auth/callback

# AI assistant (api/chat.js): Anthropic first, Gemini fallback
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Vercel Blob - required for Learning Center video uploads.
# Create a Blob store in Vercel Dashboard > Storage > Blob, then connect it to this project.
BLOB_READ_WRITE_TOKEN=
MEDIA_UPLOAD_MAX_BYTES=262144000

# Optional webhooks (Slack, Teams, Zapier, custom email worker)
NOTIFICATION_WEBHOOK_URL=
SALES_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Client-side (bundled into the browser build; must not contain secrets)
# ---------------------------------------------------------------------------

VITE_API_BASE_URL=/api
VITE_AUTH_EXCHANGE_ENDPOINT=/api/auth/exchange

# Optional: demo-request form fallback when the API is unavailable (local only)
VITE_ALLOW_LOCAL_LEAD_FALLBACK=false

VITE_OIDC_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_OIDC_ENTRA_AUTHORIZE_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/authorize
VITE_OIDC_ENTRA_SCOPE=openid profile email offline_access

VITE_OIDC_OKTA_CLIENT_ID=0oa0000000000000000
VITE_OIDC_OKTA_AUTHORIZE_URL=https://<your-okta-domain>/oauth2/default/v1/authorize
VITE_OIDC_OKTA_SCOPE=openid profile email offline_access
