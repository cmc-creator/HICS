# Anthropic API key - primary provider for api/chat.js
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Gemini API key - fallback provider for api/chat.js
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional legacy provider (not used by default fallback flow)
OPENAI_API_KEY=

# Optional webhook to relay notifications (password resets, session warnings, completion notices)
# Example: Slack, Teams, Zapier, custom email worker
NOTIFICATION_WEBHOOK_URL=

# Required for signed server-side access tokens (OIDC exchange and local login)
TOKEN_SIGNING_SECRET=

# Optional server-side defaults for issued token claims
DEFAULT_ORGANIZATION_NAME=Enterprise Health System
DEFAULT_USER_FACILITY=psychiatric-inpatient

# Public base URL of the deployed app - used to build the set-password
# links sent in password reset and admin invite emails
APP_BASE_URL=https://www.nyxhicslab.com

# Resend - transactional email for password resets and admin invites
# Get your key at: https://resend.com/api-keys
# Without these, password reset and invite flows still succeed but no
# email is sent (an email_not_configured notice is logged instead)
RESEND_API_KEY=
RESEND_FROM_EMAIL=NyxHICSlab <noreply@nyxhicslab.com>

# Optional bootstrap enterprise admin - on store load, if no user with
# this email exists, one is created with this password (min 10 chars),
# role enterprise-admin and facility all. Idempotent; safe to leave set.
HICS_BOOTSTRAP_ADMIN_EMAIL=
HICS_BOOTSTRAP_ADMIN_PASSWORD=

# Local demos only - when true, a fresh store is seeded with two
# passwordless demo users. Never enable in production.
HICS_SEED_DEMO=false

# Server-side refresh token lifetime in days
REFRESH_TOKEN_TTL_DAYS=30

# Vercel Blob - required for Learning Center video uploads.
# Create a Blob store in Vercel Dashboard > Storage > Blob, then connect it to this project.
# Vercel auto-adds BLOB_READ_WRITE_TOKEN when the store is linked.
BLOB_READ_WRITE_TOKEN=

# Max single video upload size accepted by signed upload endpoint (bytes)
MEDIA_UPLOAD_MAX_BYTES=262144000

# Optional durable API store settings (used by serverless API routes)
# If UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN are set, API data persists in Redis.
# Otherwise, API falls back to a local JSON file path.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
HICS_STORE_REDIS_KEY=nyx:hics:store:v1

# Optional file path override when not using Redis
HICS_STORE_FILE_PATH=.nyx-hics-store.json

# Frontend base URL for protected API calls
# For same-origin Vercel deployment with serverless routes under /api, use /api
VITE_API_BASE_URL=/api

# Frontend endpoint used to exchange OIDC auth code for app tokens
VITE_AUTH_EXCHANGE_ENDPOINT=/api/auth/exchange

# Optional local-only fallback flag for the request-demo form
VITE_ALLOW_LOCAL_LEAD_FALLBACK=false

# Google OIDC settings (primary SSO provider - "Continue with Google")
# Create an OAuth 2.0 Web client in Google Cloud Console and register
# <APP_BASE_URL>/auth/callback as an authorized redirect URI.
VITE_OIDC_GOOGLE_CLIENT_ID=
# Optional - defaults to https://accounts.google.com/o/oauth2/v2/auth when unset
VITE_OIDC_GOOGLE_AUTHORIZE_URL=
VITE_OIDC_GOOGLE_SCOPE=openid profile email

# Google OIDC server-side settings (used by /api/auth/exchange)
# Must use the SAME OAuth client as VITE_OIDC_GOOGLE_CLIENT_ID above.
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
# Optional - these default to Google's fixed endpoints when unset
OIDC_GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
OIDC_GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
OIDC_GOOGLE_ISSUER=https://accounts.google.com

# Microsoft Entra OIDC settings (optional/legacy - dormant; only needed
# for a customer whose identity provider is Entra)
VITE_OIDC_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_OIDC_ENTRA_AUTHORIZE_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/authorize
VITE_OIDC_ENTRA_SCOPE=openid profile email offline_access

# Okta OIDC settings (optional/legacy - dormant; only needed for a
# customer whose identity provider is Okta)
VITE_OIDC_OKTA_CLIENT_ID=0oa0000000000000000
VITE_OIDC_OKTA_AUTHORIZE_URL=https://<your-okta-domain>/oauth2/default/v1/authorize
VITE_OIDC_OKTA_SCOPE=openid profile email offline_access
